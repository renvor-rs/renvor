{
  "name": "image-size",
  "version": "3.0.0-renvor.1",
  "private": true,
  "description": "Local no-op replacement for image-size. Installed via an npm override so the real package - every published version of which carries unfixed high-severity DoS advisories - never enters this tree. Throws on use; the site embeds no images, so it is never called.",
  "license": "MIT OR Apache-2.0",
  "type": "commonjs",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.cjs"
      }
    },
    "./fromFile": {
      "import": {
        "types": "./fromFile.d.ts",
        "default": "./fromFile.mjs"
      },
      "require": {
        "types": "./fromFile.d.ts",
        "default": "./fromFile.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.ts",
    "fromFile.cjs",
    "fromFile.mjs",
    "fromFile.d.ts"
  ],
  "engines": {
    "node": ">=16.x"
  }
}
