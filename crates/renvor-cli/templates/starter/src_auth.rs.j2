/// Renders a stored 16-byte owner identifier the way `UserId` displays itself.
pub fn render_user_id(bytes: &[u8]) -> Option<String> {
    let bytes: [u8; 16] = bytes.try_into().ok()?;
    Some(UserId::from_bytes(bytes).to_string())
}

/// Parses a rendered owner identifier back into a `UserId`, for the ownership policy.
///
/// A rendering that does not parse — which only a corrupted row could produce — becomes the
/// all-zero identifier, which no registered user holds, so the policy refuses rather than
/// matching anyone.
pub fn user_id_from_rendered(rendered: &str) -> UserId {
    let mut bytes = [0_u8; 16];
    let digits: Vec<u8> = rendered.bytes().filter(u8::is_ascii_hexdigit).collect();
    if digits.len() == 32 {
        for (index, pair) in digits.chunks(2).enumerate() {
            let value = u8::from_str_radix(std::str::from_utf8(pair).unwrap_or("00"), 16);
            bytes[index] = value.unwrap_or(0);
        }
    }
    UserId::from_bytes(bytes)
}

#[cfg(test)]
mod tests {
    use super::{render_user_id, user_id_from_rendered};
    use renvor_auth::UserId;

    #[test]
    fn a_rendered_user_id_round_trips() {
        let id = UserId::from_bytes([7_u8; 16]);
        let rendered = render_user_id(id.as_bytes()).expect("16 bytes render");
        assert_eq!(user_id_from_rendered(&rendered), id);
        assert!(render_user_id(&[1, 2, 3]).is_none(), "not 16 bytes");
    }

    #[test]
    fn a_corrupt_rendering_becomes_the_owner_nobody_holds() {
        assert_eq!(
            user_id_from_rendered("not-an-id"),
            UserId::from_bytes([0_u8; 16])
        );
    }
}
{% endif %}
