        "rv_auth_credential",
        "rv_auth_user",
{% endif %}
        "_renvor_seeds",
        "_sqlx_migrations",
    ];
{% else %}
    let tables = ["item", "_renvor_seeds", "_sqlx_migrations"];
{% endif %}
