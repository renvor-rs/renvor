/// A running application: the child, the address it listens on{% if cap_observability %}, and the OTLP receiver it
/// exports to{% endif %}.
pub struct Application {
    /// The child; killed on drop so a failed assertion never leaves it running.
    pub child: Running,
    /// `host:port`.
    pub address: String,
{% if cap_observability %}
    /// Every request line the loopback OTLP receiver was sent.
    pub otlp: std::sync::Arc<std::sync::Mutex<Vec<String>>>,
{% endif %}
}

impl Application {
    /// Sends the interrupt a terminal sends and waits for the exit status, bounded.
    pub fn stop(&mut self) -> std::process::ExitStatus {
        interrupt_and_wait(&mut self.child.0).expect("the application stopped within the bound")
    }
}

/// Starts the application on a free loopback port, with the environment a deployment would set
/// on top of this process's own, and waits until it answers `{{ ready_path }}` — which it does
/// only once every provider has booted.
pub fn start() -> Application {
    let port = free_port();
    let address = format!("127.0.0.1:{port}");
{% if cap_observability %}
    let (otlp_endpoint, otlp) = otlp_receiver();
{% endif %}
    let mut command = Command::new(binary());
    command
        .current_dir(env!("CARGO_MANIFEST_DIR"))
        .env("RENVOR_HTTP_ADDRESS", &address)
{% if cap_observability %}
        .env("RENVOR_OTLP_ENDPOINT", &otlp_endpoint)
        .env("RENVOR_OTLP_SERVICE_NAME", NAME)
{% endif %}
{% if seed_data %}
        .env("RENVOR_SEED_SCOPE", "development")
{% endif %}
        .stdin(Stdio::null())
        .stdout(Stdio::piped())
        .stderr(Stdio::inherit());
    let mut child = Running(command.spawn().expect("the application starts"));

    // READINESS, polled: the application answers `{{ ready_path }}` only once every provider has
    // booted; an exit before that is reported as such rather than as a connection refused.
    let deadline = Instant::now() + READY_WITHIN;
    loop {
        if let Ok(Some(status)) = child.0.try_wait() {
            panic!("the application exited before it was ready: {status}");
        }
        if TcpStream::connect(&address).is_ok() {
            let reply = http(&address, "GET", "{{ ready_path }}", &[], "");
            if reply.status == 200 {
                break;
            }
        }
        assert!(
            Instant::now() < deadline,
            "the application was not ready within {READY_WITHIN:?}"
        );
        std::thread::sleep(Duration::from_millis(100));
    }
{% if cap_observability %}
    Application {
        child,
        address,
        otlp,
    }
{% else %}
    Application { child, address }
{% endif %}
}
{% if auth_session %}

/// Registers `user` (a second registration answers exactly like the first) and logs it in;
/// returns the session cookie as `name=value`, for a `Cookie` header.
pub fn session(address: &str, user: &UserDraft) -> String {
    let credentials =
        serde_json::json!({"email": user.email, "password": user.password}).to_string();
    assert_eq!(
        http(address, "POST", "/auth/register", &[], &credentials).status,
        202
    );
    let login = http(address, "POST", "/auth/login", &[], &credentials);
    assert_eq!(login.status, 200);
    login
        .header("set-cookie")
        .expect("a cookie")
        .split(';')
        .next()
        .expect("name=value")
        .to_owned()
}
