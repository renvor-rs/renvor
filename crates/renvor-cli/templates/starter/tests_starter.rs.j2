{% if auth_session and (cap_storage or cap_jobs) %}

/// A session cookie for the capability routes that require one. Registering the same address
/// twice answers exactly like the first time, so every section may call this on its own.
fn capability_session_cookie(address: &str) -> String {
    let carol =
        r#"{"email":"carol-9f3a@example.test","password":"correct-horse-battery-staple-9f3a"}"#;
    assert_eq!(
        http(address, "POST", "/auth/register", &[], carol).status,
        202
    );
    let login = http(address, "POST", "/auth/login", &[], carol);
    assert_eq!(login.status, 200);
    login
        .header("set-cookie")
        .expect("a cookie")
        .split(';')
        .next()
        .expect("name=value")
        .to_owned()
}
