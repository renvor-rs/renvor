    assert_eq!(forbidden.status, 403, "{}", forbidden.body);
    let still_there = http(&address, "GET", &format!("/items/{id}"), &[], "");
    assert_eq!(still_there.status, 200);
    let renamed = http(
        &address,
        "PUT",
        &format!("/items/{id}"),
        &ada_session,
        r#"{"name":"ada's renamed item"}"#,
    );
    assert_eq!(renamed.status, 200, "{}", renamed.body);
    let deleted = http(
        &address,
        "DELETE",
        &format!("/items/{id}"),
        &ada_session,
        "",
    );
    assert_eq!(deleted.status, 204, "{}", deleted.body);
    assert_eq!(
