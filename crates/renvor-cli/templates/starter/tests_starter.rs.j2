    let wrong = http(
        &address,
        "POST",
        "/auth/login",
        &[],
        &serde_json::json!({"email": ada.email, "password": "not-it"}).to_string(),
    );
    assert_eq!(wrong.status, 401);
    let login = http(&address, "POST", "/auth/login", &[], &register);
    assert_eq!(login.status, 200, "{}", login.body);
    let cookie = login
        .header("set-cookie")
        .expect("a session cookie")
        .split(';')
        .next()
        .expect("name=value")
        .to_owned();
    assert!(cookie.starts_with("__Host-rv_session="), "{cookie}");
    let csrf = serde_json::from_str::<serde_json::Value>(&login.body).expect("json")["csrf_token"]
        .as_str()
        .expect("a csrf token")
