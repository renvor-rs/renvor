    let bob_login = http(&address, "POST", "/auth/login", &[], &bob_register);
    assert_eq!(bob_login.status, 200);
    let bob_cookie = bob_login
        .header("set-cookie")
        .expect("a cookie")
        .split(';')
        .next()
        .expect("name=value")
        .to_owned();
    let bob_session: Vec<(&str, &str)> = vec![("Cookie", bob_cookie.as_str())];
    let forbidden = http(
        &address,
        "DELETE",
        &format!("/items/{id}"),
        &bob_session,
        "",
