{% endif %}
{% endif %}
{% if auth_session %}
{% if example_domain %}

    // ── 3. a write without a session is refused, and nothing was written ──────────
    let reply = http(&address, "POST", "/items", &[], r#"{"name":"nobody's"}"#);
    assert_eq!(reply.status, 401, "{}", reply.body);
    let reply = http(&address, "GET", "/items", &[], "");
    assert!(!reply.body.contains("nobody"), "{}", reply.body);
{% endif %}

    // ── 4. registration, a duplicate that answers identically, login ──────────────
    let ada = "ada-9f3a@example.test";
    let register = serde_json::json!({"email": ada, "password": PASSWORD}).to_string();
    let first = http(&address, "POST", "/auth/register", &[], &register);
    assert_eq!(first.status, 202, "{}", first.body);
    let again = http(&address, "POST", "/auth/register", &[], &register);
    assert_eq!(again.status, 202);
    assert_eq!(
        first.body, again.body,
