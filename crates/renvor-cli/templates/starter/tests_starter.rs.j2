{% if auth_session %}

/// Reads the verification token out of the newest message the SMTP sink holds for `address`,
/// through Mailpit's JSON API, with the standard library alone.
fn verification_token_from_sink(api: &str, address: &str) -> String {
    let api = api.trim_end_matches('/');
    let host = api.trim_start_matches("http://");
    let listing = http(
        host,
        "GET",
        "/api/v1/search?query=to:%22ada-9f3a@example.test%22",
        &[],
        "",
    );
    assert_eq!(listing.status, 200, "{}", listing.body);
    let listing: serde_json::Value = serde_json::from_str(&listing.body).expect("json");
    let id = listing["messages"]
        .as_array()
        .and_then(|messages| {
            messages.iter().find(|message| {
                message["Subject"]
                    .as_str()
                    .is_some_and(|subject| subject.starts_with("Verify"))
            })
        })
        .and_then(|message| message["ID"].as_str())
        .unwrap_or_else(|| panic!("no verification mail for {address}: {listing}"))
        .to_owned();
    let message = http(host, "GET", &format!("/api/v1/message/{id}"), &[], "");
    let message: serde_json::Value = serde_json::from_str(&message.body).expect("json");
    let text = message["Text"].as_str().expect("a text body");
    text.split_whitespace()
        .find(|word| word.len() == 64 && word.bytes().all(|byte| byte.is_ascii_hexdigit()))
        .map(str::to_owned)
        .unwrap_or_else(|| panic!("no token in the verification mail:\n{text}"))
}
{% endif %}
