    assert_eq!(me.status, 200, "{}", me.body);
    assert!(me.body.contains(&ada.email));
    assert_eq!(http(&address, "GET", "/auth/me", &[], "").status, 401);
{% if example_domain %}

    // ── 6. ownership: the creator may delete, another user may not ─────────────────
    let created = http(
        &address,
        "POST",
        "/items",
