/// Resets this project's tables and the migration ledger, so the run is the run this test
/// describes rather than the one before it. The application's own dependency does the work.
async fn reset(url: &str) {
    let pool = sqlx::{{ sqlx_pool_options }}::new()
        .max_connections(1)
        .connect(url)
        .await
        .expect("the database answers");
{% if auth_session %}
    for table in [
        "item",
{% if cap_jobs %}
        "rv_job",
        "rv_job_queue",
{% endif %}
        "rv_auth_attempt",
        "rv_auth_refresh",
        "rv_auth_refresh_family",
        "rv_auth_password_reset",
        "rv_auth_verification",
        "rv_auth_session",
        "rv_auth_credential",
        "rv_auth_user",
        "_renvor_seeds",
        "_sqlx_migrations",
    ] {
{% else %}
    for table in ["item", {% if cap_jobs %}"rv_job", "rv_job_queue", {% endif %}"_renvor_seeds", "_sqlx_migrations"] {
{% endif %}
        sqlx::query(sqlx::AssertSqlSafe(format!("DROP TABLE IF EXISTS {table}")))
            .execute(&pool)
            .await
            .expect("the table is dropped");
    }
    pool.close().await;
}
{% endif %}

