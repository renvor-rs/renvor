#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn the_http_defaults_parse_and_name_the_local_domain() {
        // Bound to a name first so the line's width does not depend on the project's name.
        let expected = "{{ local_domain }}";
        let defaults = http_defaults();
        assert_eq!(defaults["local_domain"].as_str(), Some(expected));
    }
{% if auth_session %}

    #[test]
    fn a_key_must_be_exactly_sixty_four_hex_characters() {
        assert!(decode_key(&"ab".repeat(32)).is_ok());
        assert!(decode_key(&"AB".repeat(32)).is_ok());
        assert!(decode_key(&"ab".repeat(31)).is_err(), "too short");
        assert!(decode_key(&"ab".repeat(33)).is_err(), "too long");
        assert!(decode_key(&"zz".repeat(32)).is_err(), "not hex");
        assert!(decode_key("").is_err(), "empty");
    }

    #[test]
    fn the_session_numbers_are_checked_at_validate_naming_the_key() {
        let section = |idle: u64, absolute: u64, per_user: u32| AuthSection {
            session_idle_secs: idle,
            session_absolute_secs: absolute,
            sessions_per_user: per_user,
            csrf_key: "ab".repeat(32),
            abuse_key: "ab".repeat(32),
        };
        assert!(check_auth_section(&section(1800, 28800, 5)).is_ok());
        let key = |idle, absolute, per_user| {
            check_auth_section(&section(idle, absolute, per_user))
                .expect_err("refused")
                .0
        };
        assert_eq!(key(1800, 28800, 0), "sessions_per_user");
        assert_eq!(key(0, 28800, 5), "session_idle_secs");
        assert_eq!(
            key(3601, 28800, 5),
            "session_idle_secs",
            "above the inactivity ceiling"
        );
        assert_eq!(key(1800, 0, 5), "session_absolute_secs");
        assert_eq!(
            key(1800, 86401, 5),
            "session_absolute_secs",
            "above the overall ceiling"
        );
        assert_eq!(
            key(3600, 1800, 5),
            "session_idle_secs",
            "idle beyond absolute"
        );
    }

    #[test]
    fn decoding_is_the_inverse_of_hex_encoding() {
        // POSITIVE CONTROL for the decoder: a decoder that returned zeros would pass the shape
        // tests above and make every key the same key.
        let decoded = decode_key(&"0f".repeat(32)).expect("decodes");
        assert!(decoded.iter().all(|byte| *byte == 0x0f));
        let decoded = decode_key(&format!("{}{}", "ff", "00".repeat(31))).expect("decodes");
        assert_eq!(decoded[0], 0xff);
        assert_eq!(decoded[1], 0x00);
    }
{% endif %}
