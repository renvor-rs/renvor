/// The `[auth]` section: session bounds, and the two keys that arrive only from the environment.
///
/// The keys are 32 bytes each, written as 64 hexadecimal characters:
/// `RENVOR_AUTH_CSRF_KEY` signs CSRF tokens, `RENVOR_AUTH_ABUSE_KEY` keys the abuse buckets. A
/// missing, short, or non-hex key is refused at Validate. Generate each with
/// `openssl rand -hex 32`, and never reuse one across deployments.
#[derive(Debug, Deserialize)]
pub struct AuthSection {
    /// Idle bound, seconds. `SessionPolicy` refuses more than the AAL2 ceiling.
    pub session_idle_secs: u64,
    /// Absolute bound, seconds.
    pub session_absolute_secs: u64,
    /// Live sessions per user; the stalest is evicted past this.
    pub sessions_per_user: u32,
    /// The CSRF key, 64 hex characters. Decoded by [`AuthSection::csrf_key`].
    pub csrf_key: String,
    /// The abuse-bucket key, 64 hex characters. Decoded by [`AuthSection::abuse_key`].
    pub abuse_key: String,
}

/// The all-optional form.
#[allow(dead_code, reason = "decoded, never read back; see `ConfigSchema`")]
#[derive(Debug, Default, Deserialize)]
pub struct PartialAuthSection {
    session_idle_secs: Option<u64>,
    session_absolute_secs: Option<u64>,
    sessions_per_user: Option<u32>,
    csrf_key: Option<String>,
    abuse_key: Option<String>,
}

impl ConfigSchema for AuthSection {
    type Partial = PartialAuthSection;
}

impl AuthSection {
    /// The CSRF key, decoded.
    ///
    /// # Errors
    ///
    /// The value is not 64 hexadecimal characters.
    pub fn csrf_key(&self) -> Result<[u8; 32], &'static str> {
        decode_key(&self.csrf_key)
    }

    /// The abuse-bucket key, decoded.
    ///
    /// # Errors
    ///
    /// The value is not 64 hexadecimal characters.
    pub fn abuse_key(&self) -> Result<[u8; 32], &'static str> {
        decode_key(&self.abuse_key)
    }
}

/// Decodes 64 hexadecimal characters into 32 bytes. Written here rather than pulled in as a
/// dependency: it is one loop, and a dependency for it would be the larger surface.
fn decode_key(text: &str) -> Result<[u8; 32], &'static str> {
    let text = text.trim();
    if text.len() != 64 {
        return Err("must be exactly 64 hexadecimal characters (32 bytes)");
    }
    let mut key = [0_u8; 32];
    for (index, pair) in text.as_bytes().chunks(2).enumerate() {
        let high = hex_digit(pair[0])?;
        let low = hex_digit(pair[1])?;
        key[index] = (high << 4) | low;
    }
    Ok(key)
}

fn hex_digit(byte: u8) -> Result<u8, &'static str> {
    match byte {
        b'0'..=b'9' => Ok(byte - b'0'),
        b'a'..=b'f' => Ok(byte - b'a' + 10),
        b'A'..=b'F' => Ok(byte - b'A' + 10),
        _ => Err("must be exactly 64 hexadecimal characters (32 bytes)"),
    }
}

/// The `[auth]` defaults. The keys have no default: absent is refused.
fn auth_defaults() -> Table {
    "session_idle_secs = 1800\nsession_absolute_secs = 28800\nsessions_per_user = 5\n"
        .parse()
        .expect("the defaults are valid TOML")
}

/// The numbers the session policy refuses, checked here so they stop the application at
/// Validate — naming the key — rather than while the auth provider boots, after the database and
/// mail providers have already come up. The ceilings are `SessionPolicy`'s own.
///
/// # Errors
///
/// The offending key and its constraint.
pub fn check_auth_section(section: &AuthSection) -> Result<(), (&'static str, &'static str)> {
    use renvor_auth::session::SessionPolicy;
    let idle_ceiling =
        u64::try_from(SessionPolicy::AAL2_INACTIVITY_CEILING.num_seconds()).unwrap_or(u64::MAX);
    let absolute_ceiling =
        u64::try_from(SessionPolicy::AAL2_OVERALL_CEILING.num_seconds()).unwrap_or(u64::MAX);
    if section.sessions_per_user == 0 {
        return Err(("sessions_per_user", "at least 1"));
    }
    if section.session_idle_secs == 0 || section.session_idle_secs > idle_ceiling {
        return Err((
            "session_idle_secs",
            "1 to 3600 seconds: positive, within the AAL2 inactivity ceiling",
        ));
    }
    if section.session_absolute_secs == 0 || section.session_absolute_secs > absolute_ceiling {
        return Err((
            "session_absolute_secs",
            "1 to 86400 seconds: positive, within the AAL2 overall ceiling",
        ));
    }
    if section.session_idle_secs > section.session_absolute_secs {
        return Err(("session_idle_secs", "at most session_absolute_secs"));
    }
    Ok(())
}

/// The `[auth]` source. The keys and the session numbers are validated here, so a bad value
/// stops the application before any provider constructs.
pub fn auth_source() -> SchemaSource<AuthSection> {
    let resolver = layers("auth")
        .with_defaults(auth_defaults())
        .build::<AuthSection>();
    SchemaSource::new("auth", resolver).with_validator(|resolved| {
        use renvor::kernel::error::context::{Constraint, configuration};
        let section = resolved.value();
        for (name, decoded) in [
            ("csrf_key", section.csrf_key()),
            ("abuse_key", section.abuse_key()),
        ] {
            if let Err(rule) = decoded {
                return Err(configuration(
                    name,
                    renvor_config::layer_of(resolved, name).as_str(),
                    "64 hexadecimal characters",
                    &Constraint::Rule(rule),
                ));
            }
        }
        if let Err((name, constraint)) = check_auth_section(section) {
            return Err(configuration(
                name,
                renvor_config::layer_of(resolved, name).as_str(),
                constraint,
                &Constraint::Rule("refused by the session policy"),
            ));
        }
        Ok(())
    })
}
