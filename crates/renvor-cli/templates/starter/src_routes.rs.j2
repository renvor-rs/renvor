//! The route registry — the one list the server serves, `renvor routes` prints, and
//! `renvor openapi` describes.
//!
//! Every handler reads [`Services`](crate::app::Services) from the request's state. Nothing is
//! captured at declaration, which is what lets this registry exist before the database has
//! booted — and what lets `--renvor-dump-routes` answer with no database at all.
{% if auth_session %}
//!
//! The `/auth` group is the framework's own, declared over endpoints that the auth provider
//! builds at Boot (`renvor_auth_http::routes_deferred`). Until then it answers `503`; after Boot
//! it is the same route table `renvor-auth-http` tests against a real database.
{% endif %}

use renvor::openapi::Info;
use renvor::transport::status_of;
use renvor::{ApiErrorCode, OperationSpec, ProblemDetails, Request, Response, RouteRegistry};
{% if example_domain %}
use renvor::{Declaration, Location, Method};
use schemars::JsonSchema;
{% endif %}

use crate::app::Services;

/// The description `renvor openapi` prints.
pub fn api_info() -> Info {
    Info {
        title: "{{ name }}".to_owned(),
        version: env!("CARGO_PKG_VERSION").to_owned(),
        description: Some("Generated by renvor as a framework-backed starter.".to_owned()),
    }
}
{% if example_domain or cap_jobs or cap_mail %}

/// A JSON response with a status.
pub fn json<T: serde::Serialize>(status: u16, value: &T) -> Response {
    let body = serde_json::to_string(value).expect("the response types serialise");
    Response::status(status)
        .expect("a fixed valid status")
        .with_header("content-type", "application/json")
        .expect("a fixed valid header")
        .with_body(body)
}
{% endif %}

/// A Problem Details response from the public error registry.
pub fn problem(request: &Request, code: ApiErrorCode) -> Response {
    let status = status_of(code);
    let body = ProblemDetails::new(code, status, request.context().request_id().encode())
        .to_json()
        .expect("ProblemDetails serialises");
    Response::status(status)
        .expect("the registry maps to valid statuses")
        .with_header("content-type", renvor::error::PROBLEM_MEDIA_TYPE)
        .expect("a fixed valid header")
        .with_body(body)
}

/// The application's services, from the request's state.
pub fn services(request: &Request) -> Result<&Services, Response> {
    request
        .state::<Services>()
        .map_err(|_| problem(request, ApiErrorCode::InternalError))
}
{% if example_domain %}

/// A schema declaration for a request or response type.
fn declaration<T: JsonSchema>() -> Declaration {
    Declaration::of::<T>().expect("the item types use Renvor's schema subset")
}

/// The `{id}` path parameter's declaration.
fn id_declaration() -> Declaration {
    Declaration::new(serde_json::json!({"type": "integer", "minimum": 1}))
        .expect("a positive integer is supported")
}
{% endif %}

/// Declares every route.
///
/// # Errors
///
/// A path or specification that does not validate — a defect here, since every path is a
/// literal.
pub fn registry({% if auth_session or cap_observability %}services{% else %}_services{% endif %}: &Services) -> Result<RouteRegistry, Box<dyn std::error::Error>> {
    let mut routes = RouteRegistry::new();

    routes.get("/", crate::routes::root)?.describe(
        OperationSpec::new()
            .id("root")
            .summary("Name the application")
            .tag("meta")
            .response(200, "The application's name", None),
    )?;
{% if example_domain %}

    // ── the example domain: items ─────────────────────────────────────────────────────
    routes
        .get("/items", crate::domain::routes::list)?
        .describe(
            OperationSpec::new()
                .id("listItems")
                .summary("List items")
                .tag("items")
                .response(
                    200,
                    "Every item",
                    Some(declaration::<Vec<crate::domain::Item>>()),
                ),
        )?;
    routes
        .get("/items/{id}", crate::domain::routes::get)?
        .describe(
            OperationSpec::new()
                .id("getItem")
                .summary("Get one item")
                .tag("items")
                .parameter(Location::Path, "id", true, id_declaration())
                .response(200, "The item", Some(declaration::<crate::domain::Item>()))
                .error(ApiErrorCode::ResourceNotFound),
        )?;
    routes
        .post("/items", crate::domain::routes::create)?
        .describe(
            OperationSpec::new()
                .id("createItem")
                .summary("Create an item")
                .tag("items")
                .body(true, declaration::<crate::domain::SaveItem>())
                .response(
                    201,
                    "The created item",
                    Some(declaration::<crate::domain::Item>()),
                )
                {% if auth_session %}
                .error(ApiErrorCode::AuthenticationRequired)
                {% endif %}
                .error(ApiErrorCode::ValidationFailed),
        )?;
    routes
        .route(Method::Put, "/items/{id}", crate::domain::routes::replace)?
        .describe(
            OperationSpec::new()
                .id("replaceItem")
                .summary("Replace an item")
                .tag("items")
                .parameter(Location::Path, "id", true, id_declaration())
                .body(true, declaration::<crate::domain::SaveItem>())
                .response(
                    200,
                    "The replaced item",
                    Some(declaration::<crate::domain::Item>()),
                )
{% if auth_session %}
                .error(ApiErrorCode::AuthenticationRequired)
                .error(ApiErrorCode::NotPermitted)
{% endif %}
                .error(ApiErrorCode::ResourceNotFound),
        )?;
    routes
        .route(Method::Delete, "/items/{id}", crate::domain::routes::delete)?
        .describe(
            OperationSpec::new()
                .id("deleteItem")
                .summary("Delete an item")
                .tag("items")
                .parameter(Location::Path, "id", true, id_declaration())
                .response(204, "The item was deleted", None)
{% if auth_session %}
                .error(ApiErrorCode::AuthenticationRequired)
                .error(ApiErrorCode::NotPermitted)
{% endif %}
                .error(ApiErrorCode::ResourceNotFound),
        )?;
{% endif %}
{% if auth_session %}

    // ── authentication: the framework's own group, over endpoints built at Boot ─────────
    routes.group(renvor_auth_http::routes_deferred(
        services.auth.endpoints(),
    )?)?;
{% endif %}
{% if cap_cache %}

    crate::capabilities::cache::declare(&mut routes)?;
{% endif %}
{% if cap_jobs %}
    crate::capabilities::jobs::declare(&mut routes)?;
{% endif %}
{% if cap_mail %}
    crate::capabilities::mail::declare(&mut routes)?;
{% endif %}
{% if cap_storage %}
    crate::capabilities::storage::declare(&mut routes)?;
{% endif %}
{% if cap_observability %}
    crate::capabilities::observability::declare(&mut routes, services)?;
{% endif %}

    Ok(routes)
}

/// `GET /` — the application names itself, which is what the generated test first asks for.
async fn root(_request: Request) -> Response {
    Response::text("{{ name }} is running\n")
}
