# {{ name }} — generated by renvor as a framework-backed STARTER.
#
# Every Renvor crate below is a PATH dependency on the checkout recorded in `renvor.toml`
# (`[framework]`), because no Renvor crate is published yet. When they are, each `path` becomes a
# `version` and nothing else here changes. The third-party versions are the ones that checkout
# resolves; `Cargo.lock` was seeded from its lockfile so this project resolves offline on a
# machine that has built the framework.
#
# EXACTLY the crates this project's selection needs are declared. An unselected capability is not
# an unused dependency here — it is absent, and `renvor.toml`'s `[capabilities]` says which.

[package]
name = "{{ name }}"
version = "0.1.0"
edition = "2024"
publish = false

[dependencies]
renvor = { path = "{{ framework_crates }}/renvor", features = ["transport-rest"{% if cap_cache %}, "capability-cache"{% endif %}{% if cap_jobs %}, "capability-jobs"{% endif %}{% if cap_mail %}, "capability-mail"{% endif %}{% if cap_storage %}, "capability-storage"{% endif %}{% if cap_observability %}, "observability"{% endif %}] }
renvor-config = { path = "{{ framework_crates }}/renvor-config" }
{% if database %}
renvor-database = { path = "{{ framework_crates }}/renvor-database" }
{% if orm == "sqlx" %}
renvor-sqlx = { path = "{{ framework_crates }}/renvor-sqlx", features = ["{{ driver_feature }}"{% if cap_jobs %}, "jobs"{% endif %}] }
# The driver crate itself, for the pool type the repositories name. The version and the TLS
# feature are the framework's own: `tls-rustls-ring-native-roots` rather than `runtime-tokio-rustls`,
# which would resolve `webpki-roots` (a licence Renvor rejects).
sqlx = { version = "0.9.0", default-features = false, features = ["runtime-tokio", "tls-rustls-ring-native-roots", "{{ database }}", "chrono"] }
{% else %}
renvor-seaorm = { path = "{{ framework_crates }}/renvor-seaorm", features = ["{{ driver_feature }}"{% if cap_jobs %}, "jobs"{% endif %}] }
# TWO NAMES, ONE ENGINE: `renvor-seaorm` takes `{{ driver_feature }}`, `sea-orm` takes
# `{{ seaorm_driver_feature }}`. Each resolves the {{ database }} driver and ONLY that driver.
sea-orm = { version = "2.0.2", default-features = false, features = ["macros", "runtime-tokio", "{{ seaorm_driver_feature }}"] }
sqlx = { version = "0.9.0", default-features = false, features = ["runtime-tokio", "tls-rustls-ring-native-roots", "{{ database }}", "chrono"] }
{% endif %}
{% endif %}
{% if auth_session %}
renvor-auth = { path = "{{ framework_crates }}/renvor-auth" }
renvor-auth-http = { path = "{{ framework_crates }}/renvor-auth-http" }
# The session bounds are `chrono::Duration`s, which is what `SessionPolicy::new` takes.
chrono = { version = "0.4.45", default-features = false, features = ["std", "clock"] }
{% endif %}
{% if cap_cache %}
renvor-cache = { path = "{{ framework_crates }}/renvor-cache", features = ["valkey"] }
{% endif %}
{% if cap_jobs %}
renvor-jobs = { path = "{{ framework_crates }}/renvor-jobs" }
{% endif %}
{% if cap_mail %}
renvor-mail = { path = "{{ framework_crates }}/renvor-mail", features = ["smtp"{% if auth_session %}, "auth"{% endif %}] }
{% endif %}
{% if cap_storage %}
renvor-storage = { path = "{{ framework_crates }}/renvor-storage", features = ["filesystem"] }
{% endif %}
{% if cap_observability %}
renvor-observability = { path = "{{ framework_crates }}/renvor-observability", features = ["http", "otel"] }
tracing-subscriber = { version = "0.3.23", default-features = false, features = ["registry", "fmt", "env-filter"] }
{% endif %}
schemars = { version = "1.2.2", default-features = false, features = ["derive"] }
serde = { version = "1.0.229", default-features = false, features = ["std", "derive"] }
serde_json = { version = "1.0.151", default-features = false, features = ["std"] }
tokio = { version = "1.53.1", default-features = false, features = ["macros", "rt-multi-thread", "signal"] }
tracing = { version = "0.1.44", default-features = false, features = ["std"] }

[dev-dependencies]
# `tests/starter.rs` spawns this binary and drives it over loopback HTTP with the standard
# library alone; `nix` sends it the interrupt a terminal would, so the clean-shutdown proof is a
# real signal and not a kill.
{% if database %}
sqlx = { version = "0.9.0", default-features = false, features = ["runtime-tokio", "tls-rustls-ring-native-roots", "{{ database }}"] }
{% endif %}
tokio = { version = "1.53.1", default-features = false, features = ["macros", "rt-multi-thread"] }
# Deterministic test data: the users and items the generated tests register and create.
renvor-testkit = { path = "{{ framework_crates }}/renvor-testkit", features = ["client"] }

[target.'cfg(unix)'.dev-dependencies]
nix = { version = "0.28.0", default-features = false, features = ["signal"] }

[lints.rust]
missing_docs = "warn"
unsafe_code = "forbid"
