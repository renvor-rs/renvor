//! {{ name }} — a Renvor application, generated by `renvor new` as a framework-backed starter.
//!
//! # Startup, in the order it happens
//!
//! 1. the observability subscriber, if selected — before anything can log;
//! 2. the configuration sources, one per section, decoded and validated by the kernel at
//!    **Validate** before any provider constructs;
//! 3. the providers, registered in dependency order and booted by the kernel in that order:
//!    {% if database %}the database (migrations run on Boot), {% endif %}{% if seed_data %}the development seeds (on request), {% endif %}{% if cap_mail %}mail, {% endif %}{% if cap_cache %}cache, {% endif %}{% if cap_storage %}storage, {% endif %}{% if auth_session %}the auth endpoints (after the database and mail), {% endif %}{% if cap_jobs %}the jobs worker (after the database), {% endif %}the HTTP server last;
//! 4. `--renvor-dump-routes` and the OpenAPI describe request are answered **before** Boot from
//!    the same route registry the server will use, so `renvor routes` and `renvor openapi` need
//!    no database;
//! 5. Ctrl-C drains in-flight requests within the kernel's bound and stops every provider in
//!    reverse order.
//!
//! Nothing here is hidden behind a macro. Every provider, every route, and every configuration
//! key is in a file you own.

mod app;
{% if auth_session %}
mod auth;
{% endif %}
{% if any_capability %}
mod capabilities;
{% endif %}
mod config;
{% if example_domain %}
mod domain;
{% endif %}
{% if example_domain and orm == "seaorm" %}
mod entity;
{% endif %}
{% if example_domain and orm == "sqlx" %}
mod persistence;
{% endif %}
{% if example_domain and orm == "seaorm" %}
mod repository;
{% endif %}
mod routes;
{% if seed_data %}
mod seed;
{% endif %}

use std::error::Error;

use renvor::transport::route::{describe, inspect};

/// The application's name.
const NAME: &str = "{{ name }}";

#[tokio::main]
async fn main() -> Result<(), Box<dyn Error>> {
{% if cap_observability %}
    // First, so that every later line — including a refused configuration — is a structured,
    // redacted log line rather than nothing.
    let telemetry = capabilities::observability::install()?;

{% endif %}
    let services = app::Services::new({% if cap_observability %}telemetry.registry(){% endif %});
    let registry = routes::registry(&services)?;

    // The two inspection requests `renvor routes` and `renvor openapi` send. Answered from the
    // registry the server will serve, before Boot, with no side effect.
    if let Some(answer) =
        describe::answer_openapi_request(std::env::args(), &registry, routes::api_info())
    {
        println!("{answer}");
        return Ok(());
    }
    if let Some(answer) = inspect::answer_dump_request(std::env::args(), &registry) {
        println!("{answer}");
        return Ok(());
    }

    let mut application = app::build(&services, registry)?.boot().await?;

    let address = services.http_address()?;
    println!("{NAME} is listening at http://{address}");
    tokio::signal::ctrl_c().await?;

    let report = application.shutdown().await;
    if !report.is_clean() {
        return Err("the application did not shut down cleanly".into());
    }
{% if cap_observability %}
    // Last, so the shutdown itself is exported: the flush waits for what is queued, within
    // its bound, and a flush that misses the bound is reported rather than swallowed.
    telemetry.shutdown().await?;
{% endif %}
    Ok(())
}
