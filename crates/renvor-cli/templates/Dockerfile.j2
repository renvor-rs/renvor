# Container development controls for {{ name }}.
#
# THE BUILDER IS PINNED; THE RUNTIME BASE CANNOT BE, AND THAT IS SAID RATHER THAN GLOSSED.
#
# `rust:1-slim` was a rolling tag. Two `renvor docker up --build` runs weeks apart used different
# toolchains, and a regressed push to that tag was pulled silently. Not `:latest` literally;
# identical in effect.
{% if toolchain_declared %}# THE BUILDER TAG BELOW IS DERIVED FROM THE PIN: the exact release this project's
# `rust-toolchain.toml` declares, so the image and the host build with the same compiler, and
# changing the pin changes this tag. A pin whose image tag does not exist fails the pull by name.
# A pin the image's installed toolchain does not carry fails the build by name — `rustup` inside
# the image reads the same file — because `RUSTUP_AUTO_INSTALL=0` in the builder stage forbids
# it from downloading another compiler. Nothing in this build installs a toolchain.
{% else %}# THIS PROJECT PINS NO TOOLCHAIN (it was generated before template version 8), so the builder
# is pinned to the generator's own minimum supported release rather than to a
# `rust-toolchain.toml` it does not have. Add that file by hand — the README of a newly generated
# project shows its four lines — and the tag follows the pin. `RUSTUP_AUTO_INSTALL=0` in the
# builder stage still forbids `rustup` from downloading a compiler inside the build.
{% endif %}#
# `gcr.io/distroless/cc-debian12` publishes no stable version tag — only rolling names and
# architecture-specific SHA-suffixed ones. The only real pin is a digest, and ADR-0019 records why
# a digest is refused for the database images: architecture-specific, unreadable to a human
# deciding whether to upgrade, and stale the first time upstream republishes a security rebuild.
# The same reasoning applies here, so `nonroot` stays rolling and the limitation is stated here
# instead of being hidden behind a pin that would rot.
FROM docker.io/library/rust:{{ toolchain_channel }}-slim AS build
ENV RUSTUP_AUTO_INSTALL=0
WORKDIR /src
COPY . .
RUN cargo build --release

FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=build /src/target/release/{{ name }} /app
USER nonroot:nonroot
ENTRYPOINT ["/app"]
