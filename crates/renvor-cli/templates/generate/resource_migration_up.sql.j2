-- {{ type_name }}: the `{{ table }}` table, generated by `renvor generate resource`.
--
-- Applied by version order, not by filename order. The version is the numeric prefix.
{% if database == "postgres" %}
CREATE TABLE IF NOT EXISTS {{ table }} (
    id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
{% for field in fields %}
    {{ field.name }} {{ field.sql_type }} NOT NULL{% if not loop.last %},{% endif %}

{% endfor %}
);
{% else %}
CREATE TABLE IF NOT EXISTS {{ table }} (
    id BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY,
{% for field in fields %}
    {{ field.name }} {{ field.sql_type }} NOT NULL{% if not loop.last %},{% endif %}

{% endfor %}
);
{% endif %}
