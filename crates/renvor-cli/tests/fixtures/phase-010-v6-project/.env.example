# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
#
#     cp .env.example .env
#     $EDITOR .env
#     renvor docker up
#
# WHY renvor DOES NOT WRITE `.env` FOR YOU
#
# Because doing so would mean inventing a password and persisting it. renvor would then have to
# either print it — putting a credential into your terminal scrollback, and into the CI log of
# anything that runs `renvor new` — or write it silently, leaving a working credential on disk that
# nobody chose and nobody knows the strength of. Neither is better than one `cp` and one edit.
#
# Every value below is EMPTY on purpose. `compose.yaml` uses the `${VAR:?message}` form, so a
# missing value stops the containers from starting with a message naming the variable. It does not
# fall back to a default, because a development database that silently accepts a blank password is
# how a development database ends up reachable.

# The password for the `renvor` user of the `v6_project` database.
# Used by the database container and by your application's connection string.
RENVOR_DATABASE_PASSWORD=

# The password for the local valkey container.
RENVOR_CACHE_PASSWORD=

